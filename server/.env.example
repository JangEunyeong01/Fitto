# 운영 배포에 필요한 환경변수. 실제 값은 저장소에 두지 않고 호스팅 설정에 넣는다.
# 이 파일은 "무엇을 넣어야 하는지"만 알려주는 목록이다.

# DB 접속 정보
DB_URL=jdbc:postgresql://호스트:5432/데이터베이스명
DB_USER=사용자명
DB_PASSWORD=비밀번호

# JWT 서명 키. 최소 32바이트.
# 아래처럼 만들어 쓴다:  openssl rand -base64 48
# 이 값이 새면 누구나 남의 계정 토큰을 만들 수 있다. 개발용 기본값으로 두면 서버가 부팅을 거부한다.
JWT_SECRET=여기에_충분히_긴_무작위_문자열

# 브라우저에서 접근을 허용할 주소. 쉼표로 여러 개.
CORS_ORIGINS=https://앱주소

# 프로파일 지정 (운영은 반드시 prod)
SPRING_PROFILES_ACTIVE=prod
