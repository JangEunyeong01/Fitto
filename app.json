{
  "expo": {
    "name": "Fitto",
    "slug": "fitto",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.eunyeongjang.fitto"
    },
    "android": {
      "package": "com.eunyeongjang.fitto",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.health.READ_STEPS",
        "android.permission.SCHEDULE_EXACT_ALARM"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#89C4E1"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "피또 화면 잠금을 풀 때 Face ID로 본인인지 확인해요."
        }
      ],
      "react-native-health-connect",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "피또가 걸음 수를 보여주려고 움직임 기록을 읽어요."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "dda204cf-b201-4441-bc45-7c17715d7707"
      }
    },
    "owner": "eunyeoungjs-team"
  }
}
